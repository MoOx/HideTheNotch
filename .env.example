# Copy to `.env` at the project root (fastlane loads it automatically).
# NEVER COMMIT `.env`, add it to your .gitignore.

# --- app identity ----------------------------------------------------------
APP_IDENTIFIER=io.moox.HideTheNotch
ANDROID_PACKAGE_NAME=io.moox.hidethenotch
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_ID=me@example.com

# --- certificates repository -----------------------------------------------
CERTS_REPO_URL=git@github.com:MoOx/certificates.git

# --- secrets (the only two real secrets on the project side) ---------------
# fastlane match passphrase (iOS certificates and profiles)
MATCH_PASSWORD=
# passphrase for the secrets/ directory of the certificates repository
SECRETS_PASSPHRASE=

# --- convenience -----------------------------------------------------------
FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT=120
FASTLANE_SKIP_UPDATE_CHECK=1
