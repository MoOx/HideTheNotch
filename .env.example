# Copy to `.env` at the project root (fastlane loads it automatically).
# NEVER COMMIT `.env`, add it to your .gitignore.
#
# This file is also the contract: every value the lanes read is declared here,
# with an `@needed` line naming the lanes that cannot run without it. The
# Fastfile checks it when a lane starts and lists everything that is missing at
# once, so a run stops on a readable message rather than halfway through.
#
# Where a value comes from is nobody's business. This file, a shell export, a
# keychain, GitHub secrets or variables: the check only asks whether the
# process about to build has it.
#
#   bundle exec fastlane doctor     # what is set, and which lane wants what

# --- app identity ----------------------------------------------------------

# Bundle identifier, `ios.bundleIdentifier` in app.json / app.config.js.
# @needed all
APP_IDENTIFIER=io.moox.HideTheNotch

# Play package name, when it differs from the bundle identifier.
# Falls back to APP_IDENTIFIER when unset.
ANDROID_PACKAGE_NAME=io.moox.hidethenotch

# developer.apple.com > Membership. Only the build signs, so only the build
# needs it.
# @needed ios beta
APPLE_TEAM_ID=XXXXXXXXXX

# Optional. The App Store Connect API key is enough to authenticate.
APPLE_ID=me@example.com

# --- certificates repository -----------------------------------------------

# Optional, the Fastfile has this same default.
CERTS_REPO_URL=git@github.com:MoOx/certificates.git

# --- secrets (the only two real secrets on the project side) ---------------

# fastlane match passphrase, for the iOS certificates and profiles.
# @needed ios beta, ios certificates
MATCH_PASSWORD=

# Passphrase for the secrets/ directory of the certificates repository. Every
# lane decrypts, so every lane needs it.
# @needed all
SECRETS_PASSPHRASE=

# --- release lanes ---------------------------------------------------------

# The two App Store review answers, given once here instead of retyped in the
# console on every release. Required rather than defaulted: on these two, a
# wrong answer is worse than a missing one.

# Does the app use encryption beyond what the system provides? 1 if it does.
# @needed ios release
APP_USES_ENCRYPTION=0

# Does the app collect the advertising identifier? 1 if it does.
# @needed ios release
APP_USES_IDFA=0

# --- optional integrations -------------------------------------------------

# Sentry upload token, for source maps. Build time only, never read by the
# running app: without it the build succeeds and stack traces stay minified.
# A repository secret in CI, a line here or a shell export locally.
SENTRY_AUTH_TOKEN=

# --- occasional, passed on the command line when you mean it ---------------

# `ios release` submits for review instead of stopping at the prepared version.
# SUBMIT_FOR_REVIEW=1

# `android release` promotes to a fraction of users instead of everyone.
# PLAY_ROLLOUT=0.1

# For a project that does not declare its version in app.json. Both release
# lanes read it from there otherwise.
# APP_VERSION=1.2.3

# `android bundle`, the one build Google wants uploaded by hand before the API
# will take over. Defaults to 1.
# ANDROID_VERSION_CODE=1

# --- convenience -----------------------------------------------------------
FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT=120
FASTLANE_SKIP_UPDATE_CHECK=1
