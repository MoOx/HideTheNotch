# Copy to `.env` at the project root (fastlane loads it automatically).
# NEVER COMMIT `.env`, add it to your .gitignore.

# --- app identity ----------------------------------------------------------
APP_IDENTIFIER=io.moox.HideTheNotch
ANDROID_PACKAGE_NAME=io.moox.hidethenotch
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_ID=me@example.com

# --- certificates repository -----------------------------------------------
CERTS_REPO_URL=git@github.com:MoOx/certificates.git

# --- secrets (the only two real secrets on the project side) ---------------
# fastlane match passphrase (iOS certificates and profiles)
MATCH_PASSWORD=
# passphrase for the secrets/ directory of the certificates repository
SECRETS_PASSPHRASE=

# --- crash reporting -------------------------------------------------------
# Sentry, and only for uploading source maps at build time. The app itself needs
# nothing from here: its DSN is in index.ts, committed, and public by design.
#
# Generate one at sentry.io/settings/moox/auth-tokens/, under Organization
# Tokens rather than as a personal one: it belongs to the organisation and
# outlives any one account.
#
# There is no scope to pick. An organisation token carries `org:ci` and nothing
# else, which is exactly what uploading source maps and creating a release
# needs. The per scope checkboxes belong to personal tokens, which are the ones
# not to use here.
#
# Without it, builds succeed and crash reports arrive minified.
SENTRY_AUTH_TOKEN=

# --- convenience -----------------------------------------------------------
FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT=120
FASTLANE_SKIP_UPDATE_CHECK=1
