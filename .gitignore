.harness/
renders/

# Screen captures, taken by tools/marketing/capture-*.sh.
#
# Not committed, for the same reason the deck composed from them is not: they
# are output. A hundred and fifty megabytes of them, regenerated by one command
# against a build of the current code, and stale the moment the interface moves.
# Committing them put that weight in the history for good, once per run.
#
# `npm run deck` fails with the command to run when they are missing, which is
# the only thing anyone needed them in the tree for.
marketing/captures/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
build/
*.ipa
*.dSYM.zip

# --- mobile builds (shared certificates repository) -------------------------
# Local clone of the certificates repository
.certificates/
# Secrets decrypted on the fly by the Fastfile
.secrets/
# Local variables (holds MATCH_PASSWORD / SECRETS_PASSPHRASE)
.env
!.env.example
# Build outputs
build/
*.ipa
*.dSYM.zip
*.aab
*.apk
# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
# The two store listing trees are written from marketing/listing.json by
# `npm run listing`, which the lanes run before uploading. One source, and no
# copy of six languages to keep in step with it.
fastlane/metadata/
