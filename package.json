{
  "name": "hide-the-notch",
  "version": "2.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "android": "expo run:android",
    "avd": "tools/marketing/create-avd.sh",
    "brand": "node tools/brand.cjs",
    "build:harness": "tsc -p tsconfig.harness.json && node tools/harness-check.cjs",
    "captures:android": "tools/marketing/build-android.sh && HTN_APK=$(ls android/app/build/outputs/apk/release/*.apk | head -1) tools/marketing/capture-android.sh",
    "captures:ios": "tools/marketing/build-ios-sim.sh && HTN_APP=$(ls -d build/Build/Products/Release-iphonesimulator/*.app | head -1) tools/marketing/capture-ios.sh",
    "captures:ipad": "tools/marketing/build-ios-sim.sh && HTN_APP=$(ls -d build/Build/Products/Release-iphonesimulator/*.app | head -1) HTN_DEVICE=\"iPad Air 13-inch (M4)\" HTN_OUT=marketing/captures/ipad tools/marketing/capture-ios.sh",
    "deck:fetch": "tools/marketing/fetch-deck.sh",
    "deck:preview": "tools/marketing/contact-sheet.sh",
    "deck": "node tools/marketing/compose.cjs --out marketing/renders/app-store && node tools/marketing/compose.cjs --spec marketing/shots-ipad.json --out marketing/renders/app-store-ipad && node tools/marketing/compose.cjs --spec marketing/shots-play.json --out marketing/renders/play",
    "demo:android": "tools/marketing/demo-android.sh",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "ios": "expo run:ios",
    "lint": "oxlint",
    "doctor": "tools/fastlane.sh doctor",
    "bundle:android": "tools/fastlane.sh android bundle",
    "codes:android": "tools/fastlane.sh android codes",
    "beta:ios": "tools/fastlane.sh ios beta",
    "beta:android": "tools/fastlane.sh android beta",
    "promote:ios": "tools/fastlane.sh ios release",
    "promote:android": "tools/fastlane.sh android release",
    "metadata:android": "tools/fastlane.sh android metadata",
    "metadata:ios": "tools/fastlane.sh ios metadata",
    "release": "node tools/release.cjs",
    "store:listing": "node tools/marketing/listing.cjs",
    "marketing:serve": "node tools/marketing/serve.cjs",
    "press-kit": "node tools/marketing/press-kit.cjs",
    "postinstall": "patch-package",
    "prepare": "git config core.hooksPath .githooks || true",
    "samples": "npm run build:harness && node tools/render-samples.cjs",
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "verify": "npm run build:harness && node tools/verify-render.cjs"
  },
  "dependencies": {
    "@expo/ui": "~57.0.9",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "^2.6.2",
    "expo": "~57.0.11",
    "expo-application": "~57.0.1",
    "expo-blur": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-media-library": "~57.0.3",
    "expo-sensors": "~57.0.2",
    "expo-sharing": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.12",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.6",
    "expo-build-properties": "~57.0.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3"
  },
  "//overrides": "@expo/ui pulls react-dom for its web build, which we never use, and that react-dom wants a newer react than the one Expo pins. Forcing the tree onto our react keeps npm ci reproducible."
}
